# Шаблон окружения sttm-server. Скопируйте в .env и заполните реальными
# значениями — сам .env в .gitignore и никогда не коммитится.
#
#   cp .env.example .env
#
# Читается двумя путями: dotenv.config() в src/config/db.js и src/config/minio.js,
# и через env_file в docker-compose.yml.

PORT=5000

# MySQL. Без этих переменных mysql2 молча уходит на localhost:3306, которого
# внутри контейнера нет, и любой запрос к БД падает с ECONNREFUSED → 500.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# MinIO (хранилище документов).
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Префикс, по которому браузер ходит в MinIO через обратный прокси админки.
# Пусто — ссылки остаются абсолютными и ведут прямо в MinIO (нужен публичный
# доступ к порту, а под HTTPS ломается mixed content).
# Перекрывает MINIO_PUBLIC_URL: применяется и к публичным, и к подписанным
# ссылкам. Прокси на той стороне обязан подставлять Host самого MinIO, иначе
# подпись SigV4 не сойдётся и придёт 403.
MINIO_BROWSER_PREFIX=/uploads

# Подпись JWT. Без неё код падает на дефолт "dev-secret-change-me".
JWT_SECRET=
JWT_EXPIRES_IN=7d
