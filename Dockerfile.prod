FROM node:20-alpine

ENV NODE_ENV=production

WORKDIR /app

# `npm ci` follows package-lock.json exactly, so the image matches what was
# tested; --omit=dev keeps nodemon and the rest of the dev tree out.
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node . .

USER node

EXPOSE 5000

# Not `npm run start`: exec'ing node directly lets the SIGTERM from `docker stop`
# reach the process instead of dying in the npm wrapper.
CMD ["node", "index.js"]
